{
  "bind": "127.0.0.1",
  "port": 8765,
  "policy": {
    "local_roots": [],
    "network_ranges": [
      "192.0.2.0/24"
    ],
    "servers": [],
    "operations": [
      "discover",
      "list",
      "stat",
      "read",
      "write",
      "mkdir",
      "rename",
      "copy",
      "delete"
